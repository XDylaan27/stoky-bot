# ==========================================================
# CONFIGURACIÓN DEL BOT DE WHATSAPP (STOKY - TIKTOK STICKER BOT)
# ==========================================================

# 1. SEGURIDAD Y WHITELIST (Obligatorio)
# Tu número de WhatsApp PERSONAL (administrador del bot).
# Formato con código de país (sin '+' ni espacios).
# Ejemplo: 573001234567 o 573001234567@s.whatsapp.net
ALLOWED_JID=573001234567@s.whatsapp.net

# (Opcional) Número del bot para vincular con Código de Emparejamiento de 8 dígitos en vez de QR (ideal para Termux)
# PAIRING_NUMBER=573115040555

# 2. RAPIDAPI - TIKTOK COMMENTS API (ScrapTik)
# Claves de RapidAPI (puedes poner varias separadas por coma para rotación automática y failover)
RAPIDAPI_KEYS=tu_primera_key_aqui,tu_segunda_key_aqui
RAPIDAPI_KEY=tu_primera_key_aqui
RAPIDAPI_HOST=scraptik.p.rapidapi.com

# 3. METADATOS Y APARIENCIA DE LOS STICKERS
STICKER_PACK=Stoky Stickers
STICKER_AUTHOR=Stoky Bot

# Modo de recorte: "full" (mantiene proporción con silueta recortada) o "cropped"
STICKER_TYPE=full

# Calidad de compresión (1 - 100)
STICKER_QUALITY=75

# 4. ANTI-BAN Y ANTI-SPAM
# Cooldown mínimo en segundos entre peticiones
COOLDOWN_SECONDS=5

# Nivel de logs: 'silent', 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# 5. CATÁLOGO WEB
CATALOG_URL=https://dylaan.dev/lab/stoky-catalogo
