# Minimo para convertir enlaces de TikTok
ALLOWED_JID=573001234567@s.whatsapp.net
RAPIDAPI_KEYS=
RAPIDAPI_HOST=scraptik.p.rapidapi.com

# Opcional: numero DE LA CUENTA DEL BOT para vincular por codigo
# PAIRING_NUMBER=573001234567

STICKER_PACK=Stoky Stickers
STICKER_AUTHOR=Stoky Bot
STICKER_QUALITY=75
COOLDOWN_SECONDS=5
LOG_LEVEL=info
# Maximo de paginas por enlace; cada pagina consume una solicitud
MAX_COMMENT_PAGES=10

# Opcional: publicar stickers en tu catalogo web
SUPABASE_URL=
SUPABASE_KEY=
# Opcional: solo en el servidor del bot si necesita actualizar filas protegidas.
# Nunca uses esta clave en el frontend ni en variables NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
CATALOG_URL=https://portafoliowebdylan.vercel.app/lab/stoky-catalogo

# Solo para npm run start:cloud. Secretos privados; no completar en este ejemplo.
# STOKY_STATE_URL=
# STOKY_STATE_TOKEN=
# STOKY_STATE_KEY=

# Diagnostico de enlaces (consola y scratch/tiktok-debug.jsonl)
TIKTOK_DEBUG=false

# Opcional: ruta de un FFmpeg propio. Si se omite se usa el incluido o el del sistema.
# FFMPEG_PATH=C:/ruta/ffmpeg.exe

